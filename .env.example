APP_NAME=Problem Bank API

POSTGRES_HOST=localhost
POSTGRES_DB=problem_bank
POSTGRES_USER=problem_bank
POSTGRES_PASSWORD=problem_bank_local
POSTGRES_PORT=25431

FUSEKI_PORT=3030
FUSEKI_JVM_ARGS=-Xms256m -Xmx1g
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=problem-bank
FUSEKI_REQUEST_TIMEOUT_SECONDS=5

GRAPH_SYNC_ENABLED=true
GRAPH_SYNC_POLL_SECONDS=2
GRAPH_SYNC_BATCH_SIZE=25
GRAPH_SYNC_MAX_ATTEMPTS=5
GRAPH_SYNC_LOCK_TIMEOUT_SECONDS=60
